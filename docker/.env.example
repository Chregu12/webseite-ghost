# ---------------------------------------------------------------------------
# Copy to .env and fill in. Do NOT commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Domains (production) ---------------------------------------------------
# Public website (Next.js) and Ghost CMS/admin host.
SITE_DOMAIN=example.com
CMS_DOMAIN=cms.example.com

# Public URL Ghost should advertise. Local dev: http://localhost:2368
# Production: https://cms.example.com
GHOST_URL=http://localhost:2368

# --- Database ---------------------------------------------------------------
DB_NAME=ghost
DB_USER=ghost
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# --- Ghost API keys ---------------------------------------------------------
# Create a Custom Integration in Ghost Admin (Settings -> Integrations) AFTER
# first boot, then paste the keys here and restart the frontend.
GHOST_CONTENT_API_KEY=
GHOST_ADMIN_API_KEY=

# Shared secret for the Ghost webhook -> Next.js /api/revalidate endpoint.
REVALIDATE_SECRET=change-me-random-secret

# Secret for draft preview links (/api/preview?secret=...).
PREVIEW_SECRET=change-me-preview-secret

# Contact form: recipient address + From address (uses the MAIL_* SMTP below).
CONTACT_TO=
MAIL_FROM=

# --- Mail (optional locally; required for members/newsletter) ---------------
MAIL_SERVICE=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
